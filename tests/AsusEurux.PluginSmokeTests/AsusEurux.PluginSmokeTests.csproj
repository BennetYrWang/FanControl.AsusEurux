  <ItemGroup>
    <ProjectReference Include="../../src/FanControl.AsusEurux/FanControl.AsusEurux.csproj" />
    <Reference Include="FanControl.Plugins">
      <HintPath>$(FanControlDir)\FanControl.Plugins.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
