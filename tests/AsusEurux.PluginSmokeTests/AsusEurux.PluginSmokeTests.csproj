    <AssemblyName>AsusEurux.PluginSmokeTests</AssemblyName>
    <RootNamespace>AsusEurux.PluginSmokeTests</RootNamespace>
    <FanControlDir Condition="'$(FanControlDir)' == ''">C:\Program Files (x86)\FanControl</FanControlDir>
