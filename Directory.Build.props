<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>FanControl.AsusEurux contributors</Authors>
    <Product>FanControl ASUS ROG EURUX bridge</Product>
    <Copyright>Copyright (c) 2026 FanControl.AsusEurux contributors</Copyright>
  </PropertyGroup>
</Project>
